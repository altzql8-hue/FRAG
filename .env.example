NODE_ENV=development
PORT=3000
APP_ORIGIN=http://localhost:5173
FIREBASE_DATABASE_URL=https://test-key-system-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_PROJECT_ID=test-key-system
# Absolute path to a service account JSON, held OUTSIDE this project and web root.
GOOGLE_APPLICATION_CREDENTIALS=
# Alternatively use workload identity / Application Default Credentials on Google Cloud.
DATA_DIR=./data
TRUST_PROXY_HOPS=0
